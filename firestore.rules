rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is an active administrator
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.active == true
      );
    }

    // 1. Products: Public read for published items; admin full write
    match /products/{productId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 2. Categories: Public read for active categories; admin full write
    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // 3. Merchants: Public read for active retailers; admin write
    match /merchants/{merchantId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // 4. Affiliate Links: Strictly admin only (server routes handle redirects securely)
    match /affiliate_links/{linkId} {
      allow read, write: if isAdmin();
    }

    // 5. Click Events: Anyone can log an outbound click event; only admins can inspect/read
    match /click_events/{eventId} {
      allow create: if request.resource.data.productId is string &&
                      request.resource.data.clickId is string &&
                      request.resource.data.timestamp is string;
      allow read, update, delete: if isAdmin();
    }

    // 6. Conversions: Confidential financial records - admin only
    match /conversions/{conversionId} {
      allow read, write: if isAdmin();
    }

    // 7. Ad Slots: Public can view active configured slots; admin write
    match /ad_slots/{slotId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // 8. Ad Providers: Admin only
    match /ad_providers/{providerId} {
      allow read, write: if isAdmin();
    }

    // 9. Smart Link Providers: Admin only
    match /smartlink_providers/{providerId} {
      allow read, write: if isAdmin();
    }

    // 10. Campaigns: Admin only
    match /campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // 11. Admin Users: Admin only (superadmin privilege)
    match /admin_users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 12. Site Settings: Public read; admin write
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. Consent Records: Anonymous write (user privacy preferences); admin read
    match /consent_records/{recordId} {
      allow create: if request.resource.data.visitorId is string &&
                      request.resource.data.consentGiven is bool;
      allow read, update, delete: if isAdmin();
    }

    // 14. Audit Logs: Admin read; append-only by trusted server/admin
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
